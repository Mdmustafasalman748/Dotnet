<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="batchConnectionString"
         connectionString="Data Source=Mustafa_Salman;Initial Catalog=batch;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
    <add name="batchMdfConnectionString"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\batch.mdf;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
